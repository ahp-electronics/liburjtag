prefix=/usr
exec_prefix=${prefix}
libdir=${prefix}/lib/x86_64-linux-gnu
includedir=${prefix}/include

Name: UrJTAG
Description: Universal JTAG library, server and tools
Version: 0.14
URL: http://urjtag.org
Libs: -L${libdir} -lurjtag
Libs.private:  -lreadline -lftdi1 -lusb-1.0   -lusb-1.0  
Cflags: -I${includedir}
